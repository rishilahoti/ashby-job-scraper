# Database (self-hosted Postgres — see repo root .env.example)
DATABASE_URL=postgres://user:pass@host/db

NEXT_PUBLIC_SITE_URL=https://ashbyhq-scraper.vercel.app

# --- Auth (all optional at runtime — the app works signed-out either way) ---

# Required once any auth is enabled. Signs/encrypts session JWTs and cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth app (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URI: <site-url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth App (github.com/settings/developers > New OAuth App)
# Authorization callback URL: <site-url>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# SMTP for email-OTP sign-in. Works with a Gmail account + App Password
# (myaccount.google.com/apppasswords) or any SMTP provider (e.g. Resend's
# SMTP relay: smtp.resend.com, port 587, user "resend", password = API key).
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
