# Polling & Scheduling
DEFAULT_FREQUENCY_HOURS=12
CRON_SCHEDULE=0 0 * * *
JITTER_MAX_MINUTES=5

# Database (PostgreSQL)
DATABASE_URL=postgres://user:pass@host/db
DB_PATH=./data/jobs.db

# docker-compose only — self-hosted Postgres container credentials.
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobs

# Logging
LOG_LEVEL=info

# Intelligence
MIN_RELEVANCE_SCORE=5

# Notifications
ENABLE_CLI_OUTPUT=true
ENABLE_MARKDOWN_REPORT=true
REPORTS_DIR=./reports

# Daily digest email (numbers + ready-to-post LinkedIn drafts), sent after
# each scrape. Skipped while host/user/password are empty. Same SMTP vars as
# web/.env.example: a Gmail account + App Password works.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
DIGEST_EMAIL_TO=rishilahoti99@gmail.com

# The digest's LinkedIn copy (hooks, wording) is written by Groq; the numbers
# never come from the model. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Posts the digest's LinkedIn posts on your profile at 09:00, 15:00 and 21:00
# IST. A 60-day token from the token generator for a LinkedIn app with
# "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect":
# https://www.linkedin.com/developers/tools/oauth/token-generator
LINKEDIN_ACCESS_TOKEN=
