# Polling & Scheduling
DEFAULT_FREQUENCY_HOURS=12
CRON_SCHEDULE=0 */12 * * *
JITTER_MAX_MINUTES=5

# Database (Neon Postgres). Comma-separate multiple URLs for automatic failover,
# priority order — primary first, backups after. DATABASE_URL also still works alone.
DATABASE_URLS=postgres://user:pass@host1/db,postgres://user:pass@host2/db
DB_PATH=./data/jobs.db

# docker-compose only — self-hosted Postgres container credentials.
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobs

# Logging
LOG_LEVEL=info

# Intelligence
MIN_RELEVANCE_SCORE=5

# Notifications
ENABLE_CLI_OUTPUT=true
ENABLE_MARKDOWN_REPORT=true
REPORTS_DIR=./reports
