# Polling & Scheduling
DEFAULT_FREQUENCY_HOURS=12
CRON_SCHEDULE=0 0 * * *
JITTER_MAX_MINUTES=5

# Database (PostgreSQL)
DATABASE_URL=postgres://user:pass@host/db
DB_PATH=./data/jobs.db

# docker-compose only — self-hosted Postgres container credentials.
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobs

# Logging
LOG_LEVEL=info

# Intelligence
MIN_RELEVANCE_SCORE=5

# Notifications
ENABLE_CLI_OUTPUT=true
ENABLE_MARKDOWN_REPORT=true
REPORTS_DIR=./reports

# Daily digest email (numbers + ready-to-post LinkedIn drafts), sent after
# each scrape. Skipped while host/user/password are empty. Same SMTP vars as
# web/.env.example: a Gmail account + App Password works.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
DIGEST_EMAIL_TO=rishilahoti99@gmail.com
